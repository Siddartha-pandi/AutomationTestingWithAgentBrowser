# ==============================================================================
# Enterprise Automation & Testing Platform - Environment Configuration Template
# Compliance: Strict Zero-AI Policy (NO_DATA) • Engine: agent-browser CLI
# ==============================================================================

# 1. APPLICATION BRANDING & WHITE-LABELING
NEXT_PUBLIC_APP_NAME="AgentFlow Automation Platform"
NEXT_PUBLIC_COMPANY_NAME="Enterprise QA Systems"
NEXT_PUBLIC_SUPPORT_EMAIL="support@enterprise.local"

# 2. DATABASE CONFIGURATION (Strictly PostgreSQL 16; SQLite is prohibited)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/automation_platform_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=automation_platform_db

# 3. MESSAGE BROKER & ASYNCHRONOUS WORKERS (Redis 7 & Celery 5.4+)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=4

# 4. SECURITY, ENCRYPTION & AUTHENTICATION
# Generate a cryptographically secure 64-character secret for production:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-64-character-cryptographically-secure-jwt-secret
TOKEN_EXPIRY_MINUTES=480

# Master encryption key for AES-256-GCM Credential Vault:
# python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIALS_MASTER_KEY=replace-with-a-64-hex-char-aes-256-master-key

# 5. NETWORKING & CORS CONFIGURATION
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
STORAGE_DIR=./reports

# 6. BROWSER AUTOMATION ENGINE (agent-browser CLI v0.41.2)
AGENT_BROWSER_CLI=agent-browser.cmd
AGENT_BROWSER_SESSION=enterprise-automation
AGENT_BROWSER_TIMEOUT=30
DEFAULT_TIMEZONE=Asia/Kolkata

# 7. MANDATORY COMPANY DATA PROTECTION GUARANTEE
# ZERO external AI services, ZERO local LLMs, ZERO vector embeddings.
# All element recognition, self-healing, and assertion evaluations use pure deterministic algorithms.
ZERO_AI_POLICY_ENFORCED=true
