# Local SaaS configuration
# PostgreSQL example:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/obscura
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_EXPIRY_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Frontend API origin
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# Optional Agent Browser configuration for future local workers
AGENT_BROWSER_CLI=agent-browser.cmd
AGENT_BROWSER_SESSION=obscura-automation
AGENT_BROWSER_TIMEOUT=30

# Company Data Protection: AI and LLM services are strictly prohibited.
# All element recognition and self-healing use deterministic algorithms.
